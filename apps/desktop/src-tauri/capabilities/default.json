{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-daemon-state",
    "allow-list-profiles",
    "allow-status",
    "allow-import-file",
    "allow-replace-import",
    "allow-import-link",
    "allow-remove-profile",
    "allow-connect",
    "allow-submit-pin",
    "allow-cancel-credentials",
    "allow-disconnect",
    "allow-rename-profile",
    "allow-session-log",
    "allow-get-settings",
    "allow-update-settings",
    "allow-notification-permission",
    "allow-get-launch-at-login",
    "allow-set-launch-at-login",
    "allow-take-startup-notice",
    "allow-app-info",
    "allow-open-support",
    "allow-service-status",
    "allow-register-service",
    "allow-open-login-items",
    "allow-third-party-licenses",
    "allow-openvpn-notice",
    "allow-window-chrome",
    "clipboard-manager:allow-write-text"
  ]
}
